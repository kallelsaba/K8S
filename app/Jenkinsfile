pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:3355.v388858a_47b_33-3-jdk21
    resources:
      requests:
        cpu: 200m
        memory: 256Mi
  - name: docker
    image: docker:27-dind
    securityContext:
      privileged: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    args:
    - "--insecure-registry"
    - "192.168.56.10:5000"
  - name: kubectl
    image: alpine/k8s:1.31.2
    command: [sleep, infinity]
"""
    }
  }

  triggers {
    gitea(repoProviders: [giteaServer(serverAlias: 'gitea-local')])
  }

  environment {
    NEXUS        = '192.168.56.10:5000'
    BACKEND_IMG  = "${NEXUS}/k8s-cluster/backend:${BUILD_NUMBER}"
    FRONTEND_IMG = "${NEXUS}/k8s-cluster/frontend:${BUILD_NUMBER}"
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build Backend') {
      steps {
        container('docker') {
          withCredentials([usernamePassword(
            credentialsId: 'nexus-credentials',
            usernameVariable: 'USER',
            passwordVariable: 'PASS'
          )]) {
            sh """
              docker login ${NEXUS} -u \${USER} -p \${PASS}
              docker build -t ${BACKEND_IMG} backend/
              docker push ${BACKEND_IMG}
            """
          }
        }
      }
    }
    stage('Build Frontend') {
      steps {
        container('docker') {
          withCredentials([usernamePassword(
            credentialsId: 'nexus-credentials',
            usernameVariable: 'USER',
            passwordVariable: 'PASS'
          )]) {
            sh """
              docker login ${NEXUS} -u \${USER} -p \${PASS}
              docker build -t ${FRONTEND_IMG} frontend/
              docker push ${FRONTEND_IMG}
            """
          }
        }
      }
    }
    stage('Deploy') {
      steps {
        container('kubectl') {
          sh """
            kubectl -n app-registre set image deployment/backend  backend=${BACKEND_IMG}
            kubectl -n app-registre set image deployment/frontend frontend=${FRONTEND_IMG}
          """
        }
      }
    }
  }
  post {
    success { echo '✅ Déploiement réussi !' }
    failure { echo '❌ Échec du pipeline' }
  }
}